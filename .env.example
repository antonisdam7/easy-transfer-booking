# Frontend. Copy to .env for local dev, and set the same two in Vercel.
# Both values are public by design: the anon key ships in the JavaScript bundle
# and access is controlled by the row level security policies in supabase/migrations.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Maps Platform, for looking up a customer's hotel. Also public by design,
# so it is protected the way Google intends: restrict the key to the site's domains
# and to the Places API only, and set a daily quota cap in the Cloud console.
#
# Use a separate key here from the one set in Vercel. This one has to allow
# localhost and the Vercel preview domains, which the production key must not.
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# Google Analytics 4, from Admin -> Data Streams -> your web stream. Optional, and
# leaving it out is a real setting rather than an oversight: with no ID the site
# loads no analytics and shows no cookie banner, because there is then nothing to
# ask permission for. Set it in Vercel only -- measuring local development would
# put your own clicking through the funnel reports.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# The values below are NOT used by this repo. They belong in the Supabase
# dashboard under Edge Functions -> Secrets, for the booking-emails function.
#
#   RESEND_API_KEY   from resend.com
#   MAIL_FROM        e.g. bookings@habibitransferscrete.com (verified domain)
#   MAIL_TO          where new booking notifications are sent
#   WEBHOOK_SECRET   random string, must match the x-webhook-secret header
#                    configured on the database webhook
